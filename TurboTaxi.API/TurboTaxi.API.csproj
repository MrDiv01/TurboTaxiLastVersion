<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Properties\launchSettings.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.2" />
    <!-- Remove Microsoft.AspNetCore.OpenApi to avoid forcing Microsoft.OpenApi >=2.0 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Microsoft.OpenApi" Version="1.6.14" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.OpenApi" Condition="Exists('$(NuGetPackageRoot)Microsoft.OpenApi/2.6.0/lib/net8.0/Microsoft.OpenApi.dll')">
      <HintPath>$(NuGetPackageRoot)Microsoft.OpenApi/2.6.0/lib/net8.0/Microsoft.OpenApi.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.OpenApi" Condition="!Exists('$(NuGetPackageRoot)Microsoft.OpenApi/2.6.0/lib/net8.0/Microsoft.OpenApi.dll') and Exists('$(NuGetPackageRoot)Microsoft.OpenApi/2.6.0/lib/netstandard2.0/Microsoft.OpenApi.dll')">
      <HintPath>$(NuGetPackageRoot)Microsoft.OpenApi/2.6.0/lib/netstandard2.0/Microsoft.OpenApi.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TurboTaxi.Infrastructure\TurboTaxi.Infrastructure.csproj" />
    <ProjectReference Include="..\TurboTaxi.Realtime\TurboTaxi.Realtime.csproj" />
  </ItemGroup>

</Project>
